# Copy this file to .env and fill in your values
# cp .env.example .env

# Database path for the API server
DB_PATH=memories.db

# Set to 1 if BGE model is already cached locally (faster startup, no HF Hub calls)
HF_HUB_OFFLINE=1

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Postgres DSN for running contract tests against PostgreSQL
# Start postgres with: docker compose -f docker/docker-compose.yml up postgres -d
TEST_POSTGRES_DSN=postgresql://memvault:memvault@localhost:5433/memvault